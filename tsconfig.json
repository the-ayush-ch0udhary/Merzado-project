{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "backend/**/*.js",
    "frontend/src/**/*.js",
    "frontend/src/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*"
  ]
}
